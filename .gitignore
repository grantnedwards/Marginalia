# ---- secrets: never commit ----------------------------------------------
.env
.env.*
!.env.example
*.token
*.pem

# ---- database: lives on the host, never in git ---------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
backups/

# ---- ebooks: we ingest then delete; never redistribute the file ---------
*.epub
*.mobi
*.azw
*.azw3
*.pdf
books/
ingest_inbox/

# ---- python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- editors / os -------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
