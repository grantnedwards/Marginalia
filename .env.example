# Copy to .env, fill in, `chmod 600 .env`. .env is gitignored -- never commit it.
# The first FOUR below are REQUIRED. config.load() validates at startup and the error
# names every missing one at once, then exits 2. It never quotes a VALUE, so a
# token pasted into the wrong slot cannot reach a log.

# The ONLY secret this bot needs. Developer Portal -> Marginalia -> Bot ->
# Reset Token. Shown ONCE. Goes on the unRAID box and nowhere else.
# If it leaks, Reset Token again -- the old one dies instantly.
DISCORD_TOKEN=

# Guild (server) ID. Right-click the server icon -> Copy Server ID.
# Needs Developer Mode: User Settings -> Advanced -> Developer Mode.
# Commands register guild-scoped, which is why they appear instantly.
GUILD_ID=

# The single channel the club lives in: #florilegium. Right-click -> Copy
# Channel ID. NOT dead config: cogs/club.py refuses /cycle-open outside it.
BOOK_CLUB_CHANNEL_ID=

# SQLite database path.
#
# ON UNRAID, DO NOT SET THIS HERE. deploy/docker-compose.yml sets it to
# /data/marginalia.db inside the container (compose `environment:` overrides
# env_file, so a value here is ignored), bind-mounted from
# /mnt/cache/appdata/marginalia -- a DIRECT cache-SSD path.
# NEVER /mnt/user/... : that is the shfs FUSE layer, which does not give SQLite
# WAL the byte-range locking it needs and is the documented cause of corrupt
# Plex/Sonarr databases. See deploy/README.md.
#
# The value below is for running the tests or the bot on a laptop only.
MARGINALIA_DB=./data/marginalia.db

# Application ID -- not a secret, kept for convenience (invite URL, portal
# cross-check). Read by no code.
DISCORD_APP_ID=1545535072151670824

# The club's timezone (IANA name). "/schedule at:19:00" means 19:00 here, and every
# reader still sees their own local time -- Discord renders the timestamps. Optional:
# falls back to TZ, then UTC. A misspelled zone refuses to boot rather than
# scheduling an hour wrong.
CLUB_TZ=America/Los_Angeles
